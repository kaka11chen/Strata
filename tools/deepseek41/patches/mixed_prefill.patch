diff --git a/src/dsv41/ds4_prefill_schedule.hpp b/src/dsv41/ds4_prefill_schedule.hpp
new file mode 100644
--- /dev/null
+++ b/src/dsv41/ds4_prefill_schedule.hpp
@@ -0,0 +1,31 @@
+// Experimental per-model prefill schedule; no tensors, kernels or cache ownership.
+#pragma once
+
+namespace strata::ds4 {
+class MixedPrefillSchedule {
+public:
+    explicit MixedPrefillSchedule(bool enabled = false) : enabled_(enabled) {}
+
+    // Every feed starts here, including feeds that bypass path selection. A failed or cancelled
+    // previous feed cannot later be counted as successful by an unrelated single-token feed.
+    void begin_feed() { pending_ = false; }
+
+    // -1 keeps the native automatic selector. Only eligible feeds call pick().
+    int pick() {
+        if (!enabled_) return -1;
+        pending_ = true;
+        return used_flow_ ? 0 : 1;
+    }
+
+    // Called only after a successful feed. KV reset intentionally does not reset this model-lifetime state.
+    void complete() {
+        if (pending_) used_flow_ = true;
+        pending_ = false;
+    }
+
+private:
+    const bool enabled_;
+    bool used_flow_ = false;
+    bool pending_ = false;
+};
+}  // namespace strata::ds4
