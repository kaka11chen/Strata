 namespace strata::ds4 {
+// Only the exact experimental value 1 lowers flow retention heat; all other settings keep 4.
+// This is admission into free slots, independent of the post-prompt preload threshold.
+constexpr float flow_store_min_heat(const char* setting = nullptr) {
+    return setting != nullptr && setting[0] == '1' && setting[1] == '\0' ? 1.0f : 4.0f;
+}
