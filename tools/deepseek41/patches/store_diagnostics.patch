+// Opt-in observations only: deltas of the engine's existing counters. Store bytes count submitted
+// expert payloads (demand and prefetch), not physical disk traffic. cpu_ms includes store wait.
+void print_store_stats(const char* phase, const strata::ds4::Stats& before, const strata::ds4::Stats& after) {
+    std::printf("STORE phase=%s tokens=%lld hits=%lld misses=%lld submitted_bytes=%lld wait_ms=%.3f cpu_lane_ms=%.3f "
+                "evictions=%lld read_fails=%lld prefetched=%lld prefetch_used=%lld prefetch_wasted=%lld "
+                "slots=%lld slots_max=%lld\n",
+                phase, (long long) (after.tokens - before.tokens),
+                (long long) (after.store_hits - before.store_hits), (long long) (after.store_misses - before.store_misses),
+                (long long) (after.store_bytes - before.store_bytes), after.store_wait_ms - before.store_wait_ms,
+                after.cpu_ms - before.cpu_ms, (long long) (after.store_evictions - before.store_evictions),
+                (long long) (after.store_fails - before.store_fails), (long long) (after.store_prefetched - before.store_prefetched),
+                (long long) (after.store_pf_used - before.store_pf_used), (long long) (after.store_pf_wasted - before.store_pf_wasted),
+                (long long) after.store_slots, (long long) after.store_slots_max);
+}
