 };
+// Independent default-off first-feed guard. Larger first feeds also consume the opportunity on success.
+class FirstWindowPrefill {
+public:
+    explicit FirstWindowPrefill(bool enabled = false) : enabled_(enabled) {}
+
+    void begin_feed() { pending_ = false; }
+
+    // Only eligible feeds call this. False delegates to the original automatic picker.
+    bool pick(int tokens, int window) {
+        if (!enabled_) return false;
+        pending_ = true;
+        return !completed_ && tokens <= window;
+    }
+
+    // Failed/cancelled feeds do not call this. Bypasses never create a pending selection.
+    void complete() {
+        if (pending_) completed_ = true;
+        pending_ = false;
+    }
+
+private:
+    const bool enabled_;
+    bool completed_ = false;
+    bool pending_ = false;
+};
 }  // namespace strata::ds4
