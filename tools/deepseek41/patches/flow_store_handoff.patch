diff --git a/src/dsv41/ds4_store.hpp b/src/dsv41/ds4_store.hpp
--- a/src/dsv41/ds4_store.hpp
+++ b/src/dsv41/ds4_store.hpp
@@ -139,2 +139,39 @@
         return (unsigned long long) ((uint8_t*) chunk_dev_[c] + (slots_[(size_t) slot].base - (uint8_t*) chunks_[c].first));
+    }
+
+    enum class Retain { stored, present, no_room, invalid };
+    /// Copy a completed flow read into a FREE slot, without I/O or eviction. The caller serializes this with
+    /// find()/metadata readers, as in the single-device flow worker; source spans stay valid until return.
+    /// Existing blobs (including unpinned ones borrowed by flow I/O) never move. Mapped arenas cannot grow here:
+    /// registering host memory while a GPU kernel runs can block; only their already committed slots may be used.
+    Retain retain_free(int layer, int e, const uint8_t* const parts[3], const size_t bytes[3]) {
+        std::lock_guard<std::mutex> lk(mu_);
+        if (layer < 0 || layer >= (int) geo_.size() || e < 0 || e >= geo_[(size_t) layer].n_exp ||
+            parts == nullptr || bytes == nullptr) return Retain::invalid;
+        const LayerGeo& g = geo_[(size_t) layer];
+        for (int r = 0; r < 3; ++r)
+            if (parts[r] == nullptr || bytes[r] == 0 || bytes[r] != g.bytes[r] ||
+                g.tr[r] > g.blob || bytes[r] > g.blob - g.tr[r]) return Retain::invalid;
+        if (where_[(size_t) layer][(size_t) e] >= 0) return Retain::present;   // includes an in-flight read
+        const uint64_t avail = cfg_.ram_avail ? cfg_.ram_avail() : ~uint64_t{0};
+        if (avail != ~uint64_t{0} && (avail < cfg_.floor_bytes || avail - cfg_.floor_bytes < slot_bytes_))
+            return Retain::no_room;   // committing a chunk need not have faulted its pages in yet
+        size_t s = 0;
+        while (s < nalloc_ && slots_[s].state.load(std::memory_order_acquire) != kFree) ++s;
+        if (s == nalloc_ && (cfg_.map_chunk || !grow())) return Retain::no_room;
+        Slot& sp = slots_[s];
+        for (int r = 0; r < 3; ++r) std::memcpy(sp.base + g.tr[r], parts[r], bytes[r]);
+        sp.layer = layer;
+        sp.expert = e;
+        sp.pin = 0;
+        sp.prefetch = sp.visible = false;
+        sp.left.store(0);
+        sp.bad.store(false);
+        sp.cancel.store(false);
+        sp.tick = ++clock_;
+        touch_heat(layer, e);
+        sp.state.store(kReady, std::memory_order_release);   // publish only complete, owned copies
+        where_[(size_t) layer][(size_t) e] = (int) s;
+        free_hint_ = std::max(free_hint_, s + 1);
+        return Retain::stored;
     }
